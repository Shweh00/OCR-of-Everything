{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "清取 OCR",
  "version": "0.1.0",
  "identifier": "ai.wanman.qingqu-ocr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "清取 OCR",
        "width": 1180,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis"],
    "icon": []
  }
}
